# Copy this file to .env and fill in the values from
# Supabase → Project Settings → API. Never commit .env.
#
# The app (browser) uses these two. They are public by design.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The privacy test signs in as real accounts. These are test credentials only.
PRIVACY_TEST_ARTIST_EMAIL=test.artist@igniteglass.com
PRIVACY_TEST_ARTIST_PASSWORD=
PRIVACY_TEST_MANAGER_EMAIL=
PRIVACY_TEST_MANAGER_PASSWORD=
